# Shared
COMPOSE_PROJECT_NAME=enrollchain

# Backend
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgresql://enrollchain:enrollchain@db:5432/enrollchain
CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=false

# PostgreSQL
POSTGRES_DB=enrollchain
POSTGRES_USER=enrollchain
POSTGRES_PASSWORD=enrollchain

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Blockchain development only. Production network and wallet custody are TBD.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://hardhat:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
